From: Alessio Ferri <alessio.ferri@mythread.it>
Date: Thu, 6 Aug 2026 00:00:00 +0000
Subject: [PATCH] b43: hand the PHY to the RX IQ calibration and take it back

b43_nphy_rev3_cal_rx_iq() returns an error for every N-PHY rev 3 and up,
so the RX IQ calibration does not run at all. Behind that stub sit 7510
operations of an MMIO capture of wl 6.30.102.7 on a BCM6362 (N-PHY rev 8,
radio 2057 rev 8), a third of an interface coming up.

Add the frame the gain sweep runs inside, which is brcmsmac's
wlc_phy_rxcal_physetup_nphy(), wlc_phy_rxcal_radio_setup_nphy() and the two
cleanups for rev 7 and up: fifteen PHY registers saved and put back, the PAPD
comparison off on both cores, the transmit chain pointed at the core being
calibrated and the receive chain at the other one - which is the way round
rev 7 does it, earlier revisions swap them - the AFE handed over, nine RF
control overrides, a receive to transmit sequence, and the TR switch
forced on the core being calibrated. On the radio side rev 7 and up touch
the two transmit/receive coupling registers of that core and nothing else,
the rest of that function being the radio 2056 path; the values differ from
the ones the PAPD calibration writes, 0x3 and 0x7f against 0xc and 0xf0,
because this one couples a receive chain rather than driving a tone into
it.

The four extra registers rev 7 saves, the RF control override enables
0x342, 0x343, 0x346 and 0x347, need four more slots in
tx_rx_cal_phy_saveregs, which was sized for the eleven the earlier
revisions use. Nothing else indexes past ten, so the earlier revisions are
unaffected.

What measures the tones and computes the IQ coefficients is not here, so
the function still returns an error: that is deliberate, because
b43_phy_initn() only calls b43_nphy_save_cal() when this returns zero and
there is no calibration to save.

Say plainly what this buys against the capture: nothing yet. The PAPD
frame in the previous patch showed up as matching operations because the
tone and the table writes around it lined up; here the setup is followed
immediately by its own cleanup, while in the capture seven thousand
operations of gain sweep sit between them, so there is nothing to line up
with. It is the frame the sweep needs, verified to build and to run in the
position the capture puts it - after the PAPD calibration - and no more
than that.

Verified: records #14093-#22246, from
"TBL.WR   id=0x0007 off=0x0110 len=2"
Link: https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/tree/drivers/net/wireless/broadcom/brcm80211/brcmsmac/phy/phy_n.c?id=848acc8ffe1b#n26701
Link: https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/tree/drivers/net/wireless/broadcom/brcm80211/brcmsmac/phy/phy_n.c?id=848acc8ffe1b#n26828
Link: https://github.com/aleferri/b43-6362-wip/blob/88456cb/router-data/dsl-3580l/opinit-ch1-ch6-bw20.decoded

Signed-off-by: Alessio Ferri <alessio.ferri@mythread.it>
---
--- a/drivers/net/wireless/broadcom/b43/phy_n.h
+++ b/drivers/net/wireless/broadcom/b43/phy_n.h
@@ -979,7 +993,11 @@ struct b43_phy_n {
 	int tx_pwr_last_recalc_limit;
 
 	u8 txrx_chain;
-	u16 tx_rx_cal_phy_saveregs[11];
+	/* The RX IQ calibration on N-PHY rev 7 and up saves four more PHY
+	 * registers than the earlier revisions - 0x342, 0x343, 0x346 and 0x347,
+	 * the RF control override enables - at indices 11 to 14.
+	 */
+	u16 tx_rx_cal_phy_saveregs[15];
 	u16 tx_rx_cal_radio_saveregs[22];
 
 	u16 rfctrl_intc1_save;
--- a/drivers/net/wireless/broadcom/b43/phy_n.c
+++ b/drivers/net/wireless/broadcom/b43/phy_n.c
@@ -5869,9 +5885,147 @@ static int b43_nphy_rev2_cal_rx_iq(struct b43_wldev *dev,
 	return ret;
 }
 
+/* Hand the PHY over to the RX IQ calibration for one core and remember what has
+ * to go back. brcmsmac's wlc_phy_rxcal_physetup_nphy(), the N-PHY rev 7 and up
+ * path: there the transmit core is the one being calibrated rather than the
+ * other one, and four more registers are saved.
+ */
+static void b43_nphy_rxcal_phy_setup(struct b43_wldev *dev, u8 core)
+{
+	u16 *regs = dev->phy.n->tx_rx_cal_phy_saveregs;
+	u16 afectl = core ? B43_NPHY_AFECTL_C2 : B43_NPHY_AFECTL_C1;
+	u16 afeover = core ? B43_NPHY_AFECTL_OVER : B43_NPHY_AFECTL_OVER1;
+
+	regs[0] = b43_phy_read(dev, B43_NPHY_RFSEQCA);
+	regs[1] = b43_phy_read(dev, afectl);
+	regs[2] = b43_phy_read(dev, afeover);
+	regs[3] = b43_phy_read(dev, B43_NPHY_RFCTL_INTC1);
+	regs[4] = b43_phy_read(dev, B43_NPHY_RFCTL_INTC2);
+	regs[5] = b43_phy_read(dev, B43_NPHY_RFCTL_RSSIO1);
+	regs[6] = b43_phy_read(dev, B43_NPHY_RFCTL_RSSIO2);
+	regs[7] = b43_phy_read(dev, B43_NPHY_REV3_RFCTL_OVER0);
+	regs[8] = b43_phy_read(dev, B43_NPHY_REV3_RFCTL_OVER1);
+	regs[11] = b43_phy_read(dev, B43_NPHY_REV7_RF_CTL_OVER3);
+	regs[12] = b43_phy_read(dev, B43_NPHY_REV7_RF_CTL_OVER4);
+	regs[13] = b43_phy_read(dev, B43_NPHY_REV7_RF_CTL_OVER5);
+	regs[14] = b43_phy_read(dev, B43_NPHY_REV7_RF_CTL_OVER6);
+	regs[9] = b43_phy_read(dev, B43_NPHY_PAPD_EN0);
+	regs[10] = b43_phy_read(dev, B43_NPHY_PAPD_EN1);
+
+	/* The PAPD comparison goes off on both cores for the duration. */
+	b43_phy_mask(dev, B43_NPHY_PAPD_EN0, ~0x1);
+	b43_phy_mask(dev, B43_NPHY_PAPD_EN1, ~0x1);
+
+	/* Transmit on the core being calibrated, receive on the other one. */
+	b43_phy_maskset(dev, B43_NPHY_RFSEQCA, ~0x000F, 1 << core);
+	b43_phy_maskset(dev, B43_NPHY_RFSEQCA, ~0xF000 & 0xFFFF,
+			(1 << (1 - core)) << 12);
+
+	b43_phy_mask(dev, afectl, ~0x4);
+	b43_phy_set(dev, afeover, 0x4);
+
+	b43_nphy_rf_ctl_intc_override(dev, N_INTC_OVERRIDE_PA, 0, 3);
+
+	b43_nphy_rf_ctl_override_rev7(dev, 0x8, 0, 0, false, 0);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x200, 0, 0, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x400, 1, 0, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x1, 1, 0, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x2, 1, 0, false, 2);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x800, 0, 0, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x80,
+				      b43_is_40mhz(dev) ? 2 : 0, 0, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x80, 0, 0, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x20, 0, 0, false, 1);
+
+	b43_nphy_force_rf_sequence(dev, B43_RFSEQ_RX2TX);
+	b43_nphy_rf_ctl_intc_override(dev, N_INTC_OVERRIDE_TRSW, 0x1, core + 1);
+}
+
+/* brcmsmac's wlc_phy_rxcal_phycleanup_nphy(). */
+static void b43_nphy_rxcal_phy_cleanup(struct b43_wldev *dev, u8 core)
+{
+	u16 *regs = dev->phy.n->tx_rx_cal_phy_saveregs;
+
+	b43_phy_write(dev, B43_NPHY_RFSEQCA, regs[0]);
+	b43_phy_write(dev, core ? B43_NPHY_AFECTL_C2 : B43_NPHY_AFECTL_C1,
+		      regs[1]);
+	b43_phy_write(dev, core ? B43_NPHY_AFECTL_OVER : B43_NPHY_AFECTL_OVER1,
+		      regs[2]);
+	b43_phy_write(dev, B43_NPHY_RFCTL_INTC1, regs[3]);
+	b43_phy_write(dev, B43_NPHY_RFCTL_INTC2, regs[4]);
+	b43_phy_write(dev, B43_NPHY_RFCTL_RSSIO1, regs[5]);
+	b43_phy_write(dev, B43_NPHY_RFCTL_RSSIO2, regs[6]);
+	b43_phy_write(dev, B43_NPHY_REV3_RFCTL_OVER0, regs[7]);
+	b43_phy_write(dev, B43_NPHY_REV3_RFCTL_OVER1, regs[8]);
+	b43_phy_write(dev, B43_NPHY_REV7_RF_CTL_OVER3, regs[11]);
+	b43_phy_write(dev, B43_NPHY_REV7_RF_CTL_OVER4, regs[12]);
+	b43_phy_write(dev, B43_NPHY_REV7_RF_CTL_OVER5, regs[13]);
+	b43_phy_write(dev, B43_NPHY_REV7_RF_CTL_OVER6, regs[14]);
+	b43_phy_write(dev, B43_NPHY_PAPD_EN0, regs[9]);
+	b43_phy_write(dev, B43_NPHY_PAPD_EN1, regs[10]);
+}
+
+/* The coupler the RX IQ calibration measures through, on the core being
+ * calibrated. brcmsmac's wlc_phy_rxcal_radio_setup_nphy(), rev 7 and up: there
+ * it is the two transmit/receive coupling registers of that core and nothing
+ * else, the rest of that function being the radio 2056 path. The values differ
+ * from the ones the PAPD calibration uses - 0x3 and 0x7f against 0xc and 0xf0 -
+ * because this one couples a receive chain rather than driving a tone into it.
+ */
+static void b43_nphy_rxcal_radio_setup(struct b43_wldev *dev, u8 core)
+{
+	u16 *regs = dev->phy.n->tx_rx_cal_radio_saveregs;
+	u16 pwrup = core ? R2057_TX1_TXRXCOUPLE_2G_PWRUP :
+			   R2057_TX0_TXRXCOUPLE_2G_PWRUP;
+	u16 atten = core ? R2057_TX1_TXRXCOUPLE_2G_ATTEN :
+			   R2057_TX0_TXRXCOUPLE_2G_ATTEN;
+
+	regs[0] = b43_radio_read(dev, pwrup);
+	regs[1] = b43_radio_read(dev, atten);
+
+	b43_radio_write(dev, pwrup, 0x3);
+	b43_radio_write(dev, atten, 0x7F);
+}
+
+/* brcmsmac's wlc_phy_rxcal_radio_cleanup_nphy(). */
+static void b43_nphy_rxcal_radio_cleanup(struct b43_wldev *dev, u8 core)
+{
+	u16 *regs = dev->phy.n->tx_rx_cal_radio_saveregs;
+	u16 pwrup = core ? R2057_TX1_TXRXCOUPLE_2G_PWRUP :
+			   R2057_TX0_TXRXCOUPLE_2G_PWRUP;
+	u16 atten = core ? R2057_TX1_TXRXCOUPLE_2G_ATTEN :
+			   R2057_TX0_TXRXCOUPLE_2G_ATTEN;
+
+	b43_radio_write(dev, pwrup, regs[0]);
+	b43_radio_write(dev, atten, regs[1]);
+}
+
 static int b43_nphy_rev3_cal_rx_iq(struct b43_wldev *dev,
 			struct nphy_txgains target, u8 type, bool debug)
 {
+	struct b43_phy *phy = &dev->phy;
+	u8 core;
+
+	/* Only radio 2057 rev 8 has been looked at against a capture. */
+	if (phy->rev != 8 || phy->radio_rev != 8)
+		return -1;
+
+	/* The frame the gain sweep runs inside, one core at a time: what
+	 * measures the tones and writes the IQ coefficients is not here yet, so
+	 * this hands the PHY over and takes it straight back. Returning an
+	 * error keeps b43_nphy_save_cal() out, which is right - there is no
+	 * calibration to save.
+	 */
+	for (core = 0; core < 2; core++) {
+		b43_nphy_rxcal_phy_setup(dev, core);
+		b43_nphy_rxcal_radio_setup(dev, core);
+		/* The gain sweep goes here, brcmsmac's
+		 * wlc_phy_rxcal_gainctrl_nphy_rev5().
+		 */
+		b43_nphy_rxcal_radio_cleanup(dev, core);
+		b43_nphy_rxcal_phy_cleanup(dev, core);
+	}
+
 	return -1;
 }
 
