+				b43_ntab_read(dev, B43_NTAB16(7, 0x110 + core));
+			tmp = b43_ntab_read(dev, B43_NTAB16(15, 87));
+			saved->bbmult = (tmp >> (core ? 0 : 8)) & 0xFF;
+			b43_ntab_read_bulk(dev, B43_NTAB16(15, 80 + 2 * core),
