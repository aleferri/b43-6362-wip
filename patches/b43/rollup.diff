+		b43_radio_read(dev, b43_nphy_papd_regs[core].pwrup);
+	state->atten[core] =
+		b43_radio_read(dev, b43_nphy_papd_regs[core].atten);
+	state->pwrup[off_core] =
+		b43_radio_read(dev, b43_nphy_papd_regs[off_core].pwrup);
+	state->atten[off_core] =
+		b43_radio_read(dev, b43_nphy_papd_regs[off_core].atten);
+
+	b43_radio_write(dev, b43_nphy_papd_regs[core].pwrup, 0xC);
+	b43_radio_write(dev, b43_nphy_papd_regs[core].atten, 0xF0);
+	b43_radio_write(dev, b43_nphy_papd_regs[off_core].pwrup, 0x0);
+	b43_radio_write(dev, b43_nphy_papd_regs[off_core].atten, 0xFF);
+
