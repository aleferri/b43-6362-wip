+/* The baseband multipliers the calibration works on: table 15 offsets 87 and
+ * 95. brcmsmac's wlc_phy_ipa_get_bbmult_nphy() and its set counterpart.
+ */
+static u16 b43_nphy_ipa_get_bbmult(struct b43_wldev *dev)
+{
+	return b43_ntab_read(dev, B43_NTAB16(15, 87));
+}
+
+static void b43_nphy_ipa_set_bbmult(struct b43_wldev *dev, u8 m0, u8 m1)
+{
+	u16 m0m1 = (m0 << 8) | m1;
+
+	b43_ntab_write(dev, B43_NTAB16(15, 87), m0m1);
+	b43_ntab_write(dev, B43_NTAB16(15, 95), m0m1);
+}
