+/* The scalar lookup the PAPD engine reads, one copy per core. Without it the
+ * engine runs on whatever the table happened to contain.
+ */
+static void b43_nphy_papd_scalar_tables(struct b43_wldev *dev)
+{
+	b43_ntab_write_bulk(dev, B43_NTAB32(32, 0), 64, b43_ntab_papd_scaltbl);
+	b43_ntab_write_bulk(dev, B43_NTAB32(34, 0), 64, b43_ntab_papd_scaltbl);
