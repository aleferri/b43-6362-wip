+	b43_nphy_rf_ctl_override_rev7(dev, 0x200, 1, 1 << core, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x400, 0, 1 << core, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x8, 1, 1 << core, false, 1);
