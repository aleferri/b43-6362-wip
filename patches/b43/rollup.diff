+	  B43_NPHY_PAPD_EN1, B43_NPHY_PAPD_CAL_SHIFTS1,
+	  R2057_TX1_TXRXCOUPLE_2G_PWRUP, R2057_TX1_TXRXCOUPLE_2G_ATTEN },
