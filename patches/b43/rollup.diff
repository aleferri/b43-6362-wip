+
+	b43_phy_set(dev, b43_nphy_papd_regs[core].papd_en, 0x1);
+	b43_phy_set(dev, b43_nphy_papd_regs[core].cal_shifts, 0x2000);
+	b43_phy_mask(dev, b43_nphy_papd_regs[off_core].papd_en, ~0x1);
+	b43_phy_mask(dev, b43_nphy_papd_regs[off_core].cal_shifts, ~0x2000);
