+/* One step of the receive gain ladder the RX IQ calibration walks: the two
+ * low pass filter biquad stages, the second and first low noise amplifier, and
+ * the transmit power index to drive the tone at. -1 there means drive it with a
+ * fixed gain instead of an index into the power control table.
+ */
+struct b43_nphy_rxcal_gain {
+	u16 hpvga;
+	u16 lpf_biq1;
+	u16 lpf_biq0;
+	u16 lna2;
+	u16 lna1;
+	s8 txpwrindex;
+};
+
+#define B43_NPHY_RXCAL_MAXGAININDEX	5
+#define B43_NPHY_RXCAL_TONEAMP		181
+#define B43_NPHY_RXCAL_TONEFREQ_20MHZ	2000
+#define B43_NPHY_RXCAL_TONEFREQ_40MHZ	4000
+
+enum b43_nphy_rxcal_dirn {
+	B43_NPHY_RXCAL_GAIN_INIT,
+	B43_NPHY_RXCAL_GAIN_UP,
+	B43_NPHY_RXCAL_GAIN_DOWN,
+};
+
+static const struct b43_nphy_rxcal_gain b43_nphy_rxcal_gaintbl_2ghz_rev7[] = {
+	{ 0, 0, 0, 0, 0, 10 },
+	{ 0, 0, 0, 1, 0, 10 },
+	{ 0, 0, 1, 2, 0, 10 },
+	{ 0, 0, 1, 3, 0, 10 },
+	{ 0, 0, 4, 3, 0, 10 },
+	{ 0, 0, 6, 3, 0, 10 },
+};
