+/* The measurement the vendor driver takes on every channel it visits, on N-PHY
+ * rev 8: 100 samples of one core and then 100 of the other, inside the same
+ * eight register save and restore that frames b43_nphy_poll_rssi(). It is not
+ * that function - that one interleaves the two cores and reads the calibration's
+ * RSSI registers, which this radio uses too, elsewhere.
+ *
+ * The result goes into nphy->chan_meas and nothing reads it. That is deliberate:
+ * the capture says what is measured and how, and does not say what is computed
+ * from it, so inventing a consumer would be worse than leaving the value there
+ * for the code that identifies it.
+ *
+ * NOTHING CALLS THIS YET, and the call site is a measured question rather than an
+ * open one. Calling it at the end of the channel switch costs 74 operations of
+ * the window that compares an interface coming up against the capture, because
+ * the vendor driver does not take this measurement while bringing the interface
+ * up: it takes it on the channel switches of a scan, after the point that window
+ * ends. So it is not part of switch_channel, and where it does belong is above
+ * the PHY, in the code that drives a scan dwell.
+ */
+static void b43_nphy_rev8_chan_meas(struct b43_wldev *dev)
+{
+	struct b43_phy_n *nphy = dev->phy.n;
+	static const u16 save_regs[] = {
+		B43_NPHY_AFECTL_OVER1, B43_NPHY_AFECTL_OVER,
+		B43_NPHY_AFECTL_C1, B43_NPHY_AFECTL_C2,
+		B43_NPHY_TXF_40CO_B1S0, B43_NPHY_TXF_40CO_B32S1,
+		B43_NPHY_RFCTL_LUT_TRSW_UP1, B43_NPHY_RFCTL_LUT_TRSW_UP2,
+	};
+	static const u16 meas_regs[] = {
+		B43_NPHY_REV8_MEAS_C1, B43_NPHY_REV8_MEAS_C2,
+	};
+	u16 saved[ARRAY_SIZE(save_regs)];
+	s32 buf[4] = { 0 };
+	unsigned int i, core;
+	u16 val;
+
+	for (i = 0; i < ARRAY_SIZE(save_regs); i++)
+		saved[i] = b43_phy_read(dev, save_regs[i]);
+
+	b43_nphy_rssi_select(dev, 5, N_RSSI_NB);
+
+	for (core = 0; core < ARRAY_SIZE(meas_regs); core++) {
+		for (i = 0; i < 100; i++) {
+			val = b43_phy_read(dev, meas_regs[core]);
+			buf[2 * core] += ((s8)((val & 0x3F) << 2)) >> 2;
+			buf[2 * core + 1] +=
+				((s8)(((val >> 8) & 0x3F) << 2)) >> 2;
+		}
+	}
+
+	nphy->chan_meas = (buf[0] & 0xFF) << 24 | (buf[1] & 0xFF) << 16 |
+			  (buf[2] & 0xFF) << 8 | (buf[3] & 0xFF);
+
+	for (i = 0; i < ARRAY_SIZE(save_regs); i++)
+		b43_phy_write(dev, save_regs[i], saved[i]);
+}
