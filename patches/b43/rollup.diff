+					saved->AfectrlOverride & 0x0100);
+			b43_phy_maskset(dev, B43_NPHY_AFECTL_OVER, ~0x0100,
+					saved->AfectrlOverride & 0x0100);
+			saved->AfeCtrlDacGain =
+				b43_phy_read(dev, core ?
+					     B43_NPHY_AFECTL_DACGAIN2 :
+					     B43_NPHY_AFECTL_DACGAIN1);
