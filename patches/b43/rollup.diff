+/* Hand the PHY over to the RX IQ calibration for one core and remember what has
+ * to go back. brcmsmac's wlc_phy_rxcal_physetup_nphy(), the N-PHY rev 7 and up
+ * path: there the transmit core is the one being calibrated rather than the
+ * other one, and four more registers are saved.
+ */
+static void b43_nphy_rxcal_phy_setup(struct b43_wldev *dev, u8 core)
+{
+	u16 *regs = dev->phy.n->tx_rx_cal_phy_saveregs;
+	u16 afectl = core ? B43_NPHY_AFECTL_C2 : B43_NPHY_AFECTL_C1;
+	u16 afeover = core ? B43_NPHY_AFECTL_OVER : B43_NPHY_AFECTL_OVER1;
+
+	regs[0] = b43_phy_read(dev, B43_NPHY_RFSEQCA);
+	regs[1] = b43_phy_read(dev, afectl);
+	regs[2] = b43_phy_read(dev, afeover);
+	regs[3] = b43_phy_read(dev, B43_NPHY_RFCTL_INTC1);
+	regs[4] = b43_phy_read(dev, B43_NPHY_RFCTL_INTC2);
+	regs[5] = b43_phy_read(dev, B43_NPHY_RFCTL_RSSIO1);
+	regs[6] = b43_phy_read(dev, B43_NPHY_RFCTL_RSSIO2);
+	regs[7] = b43_phy_read(dev, B43_NPHY_REV3_RFCTL_OVER0);
+	regs[8] = b43_phy_read(dev, B43_NPHY_REV3_RFCTL_OVER1);
+	regs[11] = b43_phy_read(dev, B43_NPHY_REV7_RF_CTL_OVER3);
+	regs[12] = b43_phy_read(dev, B43_NPHY_REV7_RF_CTL_OVER4);
+	regs[13] = b43_phy_read(dev, B43_NPHY_REV7_RF_CTL_OVER5);
+	regs[14] = b43_phy_read(dev, B43_NPHY_REV7_RF_CTL_OVER6);
+	regs[9] = b43_phy_read(dev, B43_NPHY_PAPD_EN0);
+	regs[10] = b43_phy_read(dev, B43_NPHY_PAPD_EN1);
+
+	/* The PAPD comparison goes off on both cores for the duration. */
+	b43_phy_mask(dev, B43_NPHY_PAPD_EN0, ~0x1);
+	b43_phy_mask(dev, B43_NPHY_PAPD_EN1, ~0x1);
+
+	/* Transmit on the core being calibrated, receive on the other one. */
+	b43_phy_maskset(dev, B43_NPHY_RFSEQCA, ~0x000F, 1 << core);
+	b43_phy_maskset(dev, B43_NPHY_RFSEQCA, ~0xF000 & 0xFFFF,
+			(1 << (1 - core)) << 12);
+
+	b43_phy_mask(dev, afectl, ~0x4);
+	b43_phy_set(dev, afeover, 0x4);
+
+	b43_nphy_rf_ctl_intc_override(dev, N_INTC_OVERRIDE_PA, 0, 3);
+
+	b43_nphy_rf_ctl_override_rev7(dev, 0x8, 0, 0, false, 0);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x200, 0, 0, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x400, 1, 0, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x1, 1, 0, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x2, 1, 0, false, 2);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x800, 0, 0, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x80,
+				      b43_is_40mhz(dev) ? 2 : 0, 0, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x80, 0, 0, false, 1);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x20, 0, 0, false, 1);
+
+	b43_nphy_force_rf_sequence(dev, B43_RFSEQ_RX2TX);
+	b43_nphy_rf_ctl_intc_override(dev, N_INTC_OVERRIDE_TRSW, 0x1, core + 1);
+}
