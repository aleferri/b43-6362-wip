+ * once the calibration is done, which is b43_nphy_int_pa_set_tx_dig_filters().
+ */
+static void b43_nphy_int_pa_restore_tx_dig_filters(struct b43_wldev *dev)
+{
+	if (b43_is_40mhz(dev))
