+	b43_phy_set(dev, b43_nphy_papd_regs[core].afeover, 0x4);
+	b43_phy_set(dev, b43_nphy_papd_regs[off_core].afectl, 0x4);
+	b43_phy_set(dev, b43_nphy_papd_regs[off_core].afeover, 0x4);
