+/* Walk the gain ladder until the tone comes back at a workable power, then
+ * trim the second biquad stage so it lands on the power the calibration wants.
+ * brcmsmac's wlc_phy_rxcal_gainctrl_nphy_rev5(), the N-PHY rev 7 and up path.
+ *
+ * The rxgain output argument of the reference is not here: both its call sites
+ * pass NULL, so nothing ever reads what it would return.
+ *
+ * Neither is the 5 GHz ladder, and the caller keeps this to 2 GHz for it. The
+ * 5 GHz one asks for a fixed transmit gain rather than a power control index on
+ * four of its six steps, and that gain is built from a value b43 does not keep -
+ * the one the reference reads out of the transmit gain table, which this file
+ * computes inside an #if 0 and stores nowhere. A ladder step that cannot be
+ * programmed is worse than a ladder that stops at the band the capture covers.
+ */
+static void b43_nphy_rxcal_gainctrl(struct b43_wldev *dev, u8 rx_core,
+				    u8 cal_type)
+{
+	const struct b43_nphy_rxcal_gain *tbl = b43_nphy_rxcal_gaintbl_2ghz_rev7;
+	struct b43_phy_n_iq_comp save_comp, zero_comp = { };
+	struct nphy_iq_est est;
+	const u16 num_samps = 1024;
+	const u32 thresh_pwr = 10000;
+	const s16 desired_log2_pwr = 13;
+	u32 curr_pwr, optim_pwr = 0, prev_pwr = 0;
+	s16 actual_log2_pwr, delta_pwr;
+	u16 lpf_biq1, lpf_biq0, lna2, lna1;
+	u8 mix_tia_gain = 3;
+	s8 optim_idx = 0, prev_idx = 0, curr_idx = 3;
+	u8 dirn = B43_NPHY_RXCAL_GAIN_INIT;
+	bool done = false;
+	int fine_gain_idx;
+	u32 tone_freq;
+	/* Rev 7 and up transmit on the core being calibrated, earlier
+	 * revisions on the other one.
+	 */
+	u8 tx_core = rx_core;
+
+	b43_nphy_rx_iq_coeffs(dev, false, &save_comp);
+	b43_nphy_rx_iq_coeffs(dev, true, &zero_comp);
+
+	tone_freq = b43_is_40mhz(dev) ? B43_NPHY_RXCAL_TONEFREQ_40MHZ :
+					B43_NPHY_RXCAL_TONEFREQ_20MHZ;
+
+	do {
+		lpf_biq1 = tbl[curr_idx].lpf_biq1;
+		lpf_biq0 = tbl[curr_idx].lpf_biq0;
+		lna2 = tbl[curr_idx].lna2;
