+};
+
+#define B43_NPHY_PAPD_EPS_TBL_SIZE	64
+
+/* The epsilon table holds two thirteen bit signed fields per cell. */
+static void b43_nphy_papd_decode_epsilon(u32 epsilon, s32 *real, s32 *imag)
+{
+	*imag = epsilon >> 13;
+	if (*imag > 0xFFF)
+		*imag -= 0x2000;
+
+	*real = epsilon & 0x1FFF;
+	if (*real > 0xFFF)
+		*real -= 0x2000;
+}
+
+
+/* One pass of the PAPD engine on one core: program the transmit gain the caller
+ * wants measured, silence the other core, set the engine up and let it sweep.
+ * What it leaves behind is the epsilon table.
+ *
+ * Only the N-PHY rev 7 and up arm of the reference is here, and inside it only
+ * the 2 GHz half, because the caller tests phy rev 8, radio rev 8 and the band.
+ * The reference passes a whole gain structure and reads one field of it out of
+ * that arm, the pad gain, so that is what this takes.
+ */
+static void b43_nphy_papd_run_one(struct b43_wldev *dev, u16 pad_gain,
+				  bool gain_ctrl, u8 core)
+{
+	struct nphy_txgains gains;
+	u16 other = core ? 0 : 1;
+	u16 shifts = core ? B43_NPHY_PAPD_CAL_SHIFTS1 :
+			    B43_NPHY_PAPD_CAL_SHIFTS0;
+	u16 txgain, thresh_lo, thresh_hi, idx;
+	u8 m[2];
+	u32 zero = 0;
+	int i;
+
+	gains = b43_nphy_get_tx_gains(dev);
+	txgain = (gains.tx_lpf[core] << 15) | (gains.txgm[core] << 12) |
+		 (gains.pga[core] << 8) | (pad_gain << 3) | gains.ipa[core];
+
+	b43_nphy_rf_ctl_override_one_to_many(dev, N_RF_CTL_OVER_CMD_TX_GAIN,
+					     txgain, 1 << core, false);
+
+	/* Radio 2057 rev 8 in 2 GHz, 20 MHz: the multiplier the tone plays at.
+	 * The other core plays nothing, so the measurement only sees this one.
+	 */
+	m[core] = b43_is_40mhz(dev) ? 45 : 64;
+	m[other] = 0;
+	b43_nphy_ipa_set_bbmult(dev, m[0], m[1]);
+
+	thresh_hi = 63;
+	idx = 25;
+	thresh_lo = 25;
+	if (gain_ctrl)
+		thresh_lo = 60;
+
+	b43_phy_maskset(dev, core ? B43_PHY_N(0x29B) : B43_PHY_N(0x297),
+			~0x1, 1);
+	b43_phy_maskset(dev, other ? B43_PHY_N(0x29B) : B43_PHY_N(0x297),
+			~0x1, 0);
+	b43_phy_maskset(dev, shifts, ~0x2000, 0x2000);
+	b43_phy_maskset(dev, other ? B43_NPHY_PAPD_CAL_SHIFTS1 :
+				     B43_NPHY_PAPD_CAL_SHIFTS0, ~0x2000, 0);
+
+	b43_phy_write(dev, B43_PHY_N(0x2A1), 0x80);
+	b43_phy_write(dev, B43_PHY_N(0x2A2), 0x100);
+
+	b43_phy_maskset(dev, shifts, ~0x0070, 11 << 4);
+	b43_phy_maskset(dev, shifts, ~0x0700, 11 << 8);
+	b43_phy_maskset(dev, shifts, ~0x0007, 3);
+
+	b43_phy_write(dev, B43_PHY_N(0x2E5), 0x20);
+
+	b43_phy_maskset(dev, B43_PHY_N(0x2A0), ~0x003F, idx);
+	b43_phy_maskset(dev, B43_PHY_N(0x29F), ~0x003F, thresh_lo);
+	b43_phy_maskset(dev, B43_PHY_N(0x29F), ~0x3F00, thresh_hi << 8);
+
+	b43_nphy_rf_ctl_override_rev7(dev, 0x8, 1, core ? 2 : 1, false, 0);
+	b43_nphy_rf_ctl_override_rev7(dev, 0x8, 0, core ? 1 : 2, false, 0);
+
+	/* The engine clears this when the sweep is over. */
+	b43_phy_write(dev, B43_PHY_N(0x2BE), 1);
+	for (i = 0; i < 1000000; i++) {
+		if (!b43_phy_read(dev, B43_PHY_N(0x2BE)))
+			break;
+		udelay(10);
+	}
+
+	b43_nphy_rf_ctl_override_rev7(dev, 0x8, 0, 0x3, false, 0);
+
+	b43_ntab_write(dev, B43_NTAB32(core ? 33 : 31, idx), zero);
+
+	b43_nphy_rf_ctl_override_one_to_many(dev, N_RF_CTL_OVER_CMD_TX_GAIN,
+					     txgain, 1 << core, true);
+}
+
+/* Walks the pad gain codes until the epsilon the engine reports stops clipping,
+ * and returns the code it settled on. One step at a time, up to twenty of them:
+ * clipping means too much gain, so the search backs off, and it stops on the
+ * first change of direction.
+ */
+static u8 b43_nphy_papd_gain_search(struct b43_wldev *dev, u8 start, u8 core)
+{
+	const u8 *codes = b43_nphy_pad_gain_codes_2057_rev7;
+	int last = ARRAY_SIZE(b43_nphy_pad_gain_codes_2057_rev7) - 1;
+	int idx = start;
+	bool clipped, was_clipped = false, first = true;
+	int i;
+
+	for (i = 0; i < 20; i++) {
+		s32 real, imag;
+		u32 cell;
+
+		b43_nphy_papd_run_one(dev, codes[idx], true, core);
+
+		cell = b43_ntab_read(dev, B43_NTAB32(core ? 33 : 31, 63));
+		b43_nphy_papd_decode_epsilon(cell, &real, &imag);
+
+		clipped = real == 4095 || real == -4096 ||
+			  imag == 4095 || imag == -4096;
+
+		if (!first && clipped != was_clipped) {
+			if (!clipped)
+				idx--;
+			break;
+		}
+
+		idx += clipped ? 1 : -1;
+		if (idx < 0 || idx > last) {
+			idx = (idx < 0) ? 0 : last;
+			break;
+		}
+
+		first = false;
+		was_clipped = clipped;
+	}
+
+	return codes[idx];
+}
+
+/* The PAPD calibration, brcmsmac's wlc_phy_a4(): the tables the engine reads,
+ * then two passes of the engine per core, the first searching for a pad gain
+ * code that does not clip.
+ */
+static void b43_nphy_papd_cal(struct b43_wldev *dev)
+{
+	struct b43_phy *phy = &dev->phy;
+	struct b43_phy_n *nphy = phy->n;
+	struct nphy_papd_restore_state state;
+	u16 orig_tx_gain[2];
+	u16 bbcfg, tmp16;
+	bool pwr_ctl;
+	u8 core;
+
+	if (!b43_nphy_ipa(dev))
+		return;
+
+	/* Only radio 2057 rev 8 is known to want these constants. */
+	if (phy->rev != 8 || phy->radio_rev != 8)
+		return;
+
+	/* Held for the whole calibration, the way wlc_phy_a4() does: the
+	 * carrier search hold is refcounted, so without it the brackets the
+	 * inner steps take show up as enter and exit pairs of their own.
+	 */
+	b43_nphy_stay_in_carrier_search(dev, true);
+
+	/* A pulse on the clear-channel assessment, right after the hold and long
+	 * before the tables: the capture reads the register at #10773, writes it
+	 * with the CCA reset bit set and then with both reset bits clear. This is
+	 * a different write from the one that saves and clears the receive reset
+	 * below, which the capture also has, inside the papd-tables window.
+	 */
+	tmp16 = b43_phy_read(dev, B43_NPHY_BBCFG);
+	b43_phy_write(dev, B43_NPHY_BBCFG, tmp16 | B43_NPHY_BBCFG_RSTCCA);
+	b43_phy_write(dev, B43_NPHY_BBCFG,
+		      tmp16 & ~(B43_NPHY_BBCFG_RSTCCA | B43_NPHY_BBCFG_RSTRX));
+
+	b43_nphy_papd_scalar_tables(dev);
+
+	/* The receive reset stays off while the calibration transmits into its
+	 * own receive chain, and whatever it was goes back at the end.
+	 */
+	bbcfg = b43_phy_read(dev, B43_NPHY_BBCFG);
+	b43_phy_mask(dev, B43_NPHY_BBCFG, ~B43_NPHY_BBCFG_RSTRX & 0xFFFF);
+
+	b43_nphy_papd_epsilon_tables_clear(dev);
+
+	/* Below here is the 2 GHz path only, which is the one the capture this
+	 * was built from exercises. The 5 GHz coupler constants differ and are
+	 * unverified.
+	 */
+	if (b43_current_band(dev->wl) != NL80211_BAND_2GHZ)
+		return;
+
+	b43_nphy_int_pa_restore_tx_dig_filters(dev);
+
+	state.bbmult = b43_nphy_ipa_get_bbmult(dev);
+
+	/* One bracket for the whole calibration, not one per pass. What the
+	 * device reprogrammes is the adjusted power table, and in this whole
+	 * region the capture writes it exactly ONCE, at #13921, after the tail
+	 * below: eight writes here against one there, and the seven extra are
+	 * the only ones in the capture that b43 does not account for - every
+	 * other region matches write for write.
+	 *
+	 * The passes still need the control off, and they get it: the disable
+	 * only touches the table when the control is actually on in the
+	 * hardware, so with this bracket open the ones inside
+	 * b43_nphy_txpwr_index() find the bits already clear and emit nothing.
+	 */
+	pwr_ctl = b43_nphy_pwr_ctl_open(dev, orig_tx_gain);
+
+	for (core = 0; core < 2; core++) {
+		u8 gain;
+
+		b43_nphy_papd_cal_setup(dev, &state, core);
+		gain = b43_nphy_papd_gain_search(dev, 0, core);
+		b43_nphy_papd_run_one(dev, gain, false, core);
+		b43_nphy_papd_cal_cleanup(dev, &state);
+	}
+
+	/* The epsilon offsets go back in and the engine goes on, once per chain,
+	 * with the status readbacks the capture has between them. At
+	 * #13842-#13854: the adjust for core 0, the two reads of 0x2bf and
+	 * 0x2c0, the adjust for core 1, the two reads of 0x2b1 and 0x2b2, and
+	 * then the enable bit on both chains. The two adjust writes are the same
+	 * pair b43_nphy_papd_epsilon_offset() does at the PHY init, and the
+	 * capture repeats them here.
+	 */
+	b43_phy_maskset(dev, B43_NPHY_EPS_TABLE_ADJ0, 0x007F,
+			nphy->papd_epsilon_offset[0] << 7);
+	b43_phy_read(dev, B43_NPHY_PAPD_STAT_ADDR0);
+	b43_phy_read(dev, B43_NPHY_PAPD_STAT_ADDR1);
+	b43_phy_maskset(dev, B43_NPHY_EPS_TABLE_ADJ1, 0x007F,
+			nphy->papd_epsilon_offset[1] << 7);
+	b43_phy_read(dev, B43_NPHY_PAPD_STAT_YRE);
+	b43_phy_read(dev, B43_NPHY_PAPD_STAT_YIM);
+	b43_phy_set(dev, B43_NPHY_PAPD_EN0, 0x0001);
+	b43_phy_set(dev, B43_NPHY_PAPD_EN1, 0x0001);
+
+	/* The comparison shift the setup switched on for the core it was
+	 * calibrating goes off again: what stays on outside the calibration has
+	 * to be the driver's state, not the calibration's.
+	 */
+	b43_phy_mask(dev, B43_NPHY_PAPD_CAL_SHIFTS0, ~0x2000);
+	b43_phy_mask(dev, B43_NPHY_PAPD_CAL_SHIFTS1, ~0x2000);
+
+	b43_phy_write(dev, B43_NPHY_BBCFG, bbcfg);
+	b43_nphy_int_pa_set_tx_dig_filters(dev);
+
+	/* And here the bracket closes, which is where the capture reprogrammes
+	 * the adjusted power table: #13921, right after the filter rows above
+	 * end at #13918.
+	 */
+	b43_nphy_pwr_ctl_close(dev, pwr_ctl);
+
+	/* And the transmit chains go back to the index they were on. brcmsmac
+	 * does this at the end of wlc_phy_a4(), one core at a time, when the
+	 * power control was off for the calibration - which on this radio it
+	 * was, because the calibration turned it off itself.
+	 *
+	 * It matters beyond the two gain cells: the next tone saves the
+	 * baseband multiplier before it plays and puts it back after, so
+	 * leaving the calibration's index programmed leaks its multiplier into
+	 * everything downstream.
+	 */
+	if (!nphy->txpwrctrl) {
+		b43_nphy_txpwr_index(dev, 1 << 0,
+				     nphy->txpwrindex[0].index_internal, false);
+		b43_nphy_txpwr_index(dev, 1 << 1,
+				     nphy->txpwrindex[1].index_internal, false);
+	}
+
+	b43_nphy_stay_in_carrier_search(dev, false);
+}
+
+/* The offset the PAPD engine applies to the epsilon table. brcmsmac computes it
+ * at the end of its PAPD calibration as
+ *
+ *	offset = -60 + 27 + eps_offset - (padgain_delta[pad_gain] + 1) / 2
+ *
+ * where eps_offset is -1 for this radio in 2 GHz and pad_gain is the index the
+ * PAPD gain search settles on. b43 has no PAPD calibration, so the offset stays
+ * at zero and the engine runs 24 dB off.
+ *
+ * Until the calibration is there, use the index the vendor driver settles on,
+ * which an MMIO capture on a BCM6362 shows to be 15 for both cores: the offset
+ * that comes out, -24, is what it programs.
+ */
+static void b43_nphy_papd_epsilon_offset(struct b43_wldev *dev)
+{
+	struct b43_phy *phy = &dev->phy;
+	struct b43_phy_n *nphy = phy->n;
+	const s16 *delta;
+	int offset, core;
+
+	if (phy->rev != 8 || phy->radio_rev != 8 ||
+	    b43_current_band(dev->wl) != NL80211_BAND_2GHZ)
+		return;
+
+	delta = b43_ntab_get_rf_pwr_offset_table(dev);
+	if (!delta)
+		return;
+
+	offset = -60 + 27 - 1 - (delta[B43_NPHY_PAPD_CAL_PAD_GAIN] + 1) / 2;
+
+	for (core = 0; core < 2; core++)
+		nphy->papd_epsilon_offset[core] = offset;
+}
+
+/* Put both transmit chains on the power control index the calibrations want to
+ * run at, before the gains they aim for are read back. brcmsmac's
+ * wlc_phy_precal_txgain_nphy() for phy rev 7 and up with the internal transmit
+ * IQ/LO calibration.
+ *
+ * The index is 10, and it is not the one the reference would pick here: it keeps
+ * 10 for radio 2057 rev 3, 4 and 6 and 0 for everything else, which puts rev 8
+ * on the 0. The capture reads offset 0xca of the per-core power control table,
+ * which is 192 + 10, so on this radio the vendor driver uses 10. That grouping
+ * in brcmsmac predates this radio, the same way its rccal grouping does, so the
+ * capture decides it and not the grouping.
+ *
+ * The reference also remembers the index here, to hand it back after the
+ * transmit calibrations. b43 has nowhere to hand it back from, so remembering it
+ * would be a write with no reader.
+ */
+static void b43_nphy_precal_txgain(struct b43_wldev *dev)
+{
+	struct b43_phy_n *nphy = dev->phy.n;
+
+	b43_nphy_txpwr_index(dev, 0x3, 10, false);
+
+	/* The multiplier at the forced index, which is what
+	 * b43_nphy_update_tx_cal_ladder() scales the calibration ladder by. It
+	 * has no other writer, so without this the ladder comes out at zero
+	 * amplitude everywhere.
+	 */
+	nphy->txcal_bbmult = b43_ntab_read(dev, B43_NTAB16(15, 87));
+}
+
+/* The vendor driver reaches its periodic calibration from the end of the PHY
+ * init, with PHY_PERICAL_PHYINIT, and with no phase pending it runs the whole
+ * sequence in one go: TX IQ/LO, then PAPD, then RX IQ, then the TX power
+ * coefficients, then RSSI. The RSSI one is part of it because the calibration
+ * type is not PHY_PERICAL_AUTO.
+ */
+static void b43_nphy_cal_perical_phyinit(struct b43_wldev *dev,
+					 struct nphy_txgains target,
+					 struct nphy_txgains cal_target,
+					 bool entry_pwr_ctrl_state)
+{
+	struct b43_phy_n *nphy = dev->phy.n;
+	u16 orig_tx_gain[2];
+	bool full;
+	u8 id;
+
+	/* Full or partial is not a constant: brcmsmac calibrates fully when the
+	 * channel is not the one the TX IQ/LO calibration last ran on, and
+	 * partially when it is, which is the same test b43_nphy_restore_cal()
+	 * makes before reusing the coefficients. Passing a constant true made
+	 * every channel look uncalibrated.
+	 *
+	 * The type the RX IQ calibration gets stays 2, the full one. brcmsmac
+	 * asks for 2 on the first calibration after an association and 0
+	 * afterwards, and b43 does not track that: 2 is the conservative half of
+	 * the choice, since 0 skips most of the calibration.
+	 */
+	full = !nphy->txiqlocal_coeffsvalid ||
+	       nphy->txiqlocal_chanspec.center_freq !=
+	       dev->phy.chandef->chan->center_freq ||
+	       nphy->txiqlocal_chanspec.channel_type !=
+	       cfg80211_get_chandef_type(dev->phy.chandef);
+
+	/* The reference runs this as a state machine, one phase per call of
+	 * wlc_phy_cal_perical_nphy_run(): INIT, six TX I/Q LO phases, PAPD, RX
+	 * I/Q, RSSI and idle TSSI. Every one of those calls brackets its phase
+	 * the same way - read the original transmit gain, save the transmit
+	 * power control state and turn it off, run the phase, put the control
+	 * back to what it was - and it is that last step which programs the
+	 * adjusted power table, 84 cells per chain. The capture programs it 36
+	 * times over the window.
+	 *
+	 * The phases run back to back here instead of one per timer tick, which
+	 * is the one thing not reproduced: nothing else in the driver is
+	 * prepared to be interrupted between them.
+	 */
+	nphy->mphase_txcal_cmdidx = 0;
+	nphy->mphase_txcal_numcmds = B43_NPHY_MPHASE_TXCAL_NUMCMDS;
+
+	for (id = B43_NPHY_MPHASE_INIT; id <= B43_NPHY_MPHASE_IDLETSSI; id++) {
+		nphy->mphase_cal_phase_id = id;
+
+		/* The six TX phases are one step here. The reference splits the
+		 * twelve calibration commands over them, two at a time; the
+		 * capture issues all twelve back to back, with a single gain
+		 * read opening the block rather than one per phase.
+		 */
+		if (id > B43_NPHY_MPHASE_TXPHASE0 &&
+		    id <= B43_NPHY_MPHASE_TXPHASE5)
+			continue;
+
+		switch (id) {
+		case B43_NPHY_MPHASE_INIT:
+			/* Nothing to do: the gains the TX I/Q LO calibration
+			 * aims for are taken by the caller, right after it
+			 * forces the index, which is where the capture has the
+			 * read.
+			 */
+			break;
+		case B43_NPHY_MPHASE_TXPHASE0:
+			/* All twelve commands, and the coefficients come out of
+			 * the table at the end of the same call.
+			 */
+			if (b43_nphy_cal_tx_iq_lo(dev, cal_target, full, false))
+				id = B43_NPHY_MPHASE_IDLETSSI;
+			break;
+		case B43_NPHY_MPHASE_PAPDCAL:
+			/* The PAPD calibration transmits longer than the
+			 * receive one, and the medium gets protected for
+			 * longer: 31000 here against the 10000 of the RX I/Q
+			 * step below. The capture writes it at #10759, with the
+			 * MAC running, in the same shape as the other. The
+			 * reference writes only the 10000 one, and only in the
+			 * RXCAL phase.
+			 */
+			b43_mac_enable(dev);
+			b43_shm_write16(dev, B43_SHM_SHARED,
+					B43_SHM_SH_CTSDUR, 31000);
+			b43_mac_suspend(dev);
+
+			/* The one bracket the capture has between the TX I/Q LO
+			 * calibration and the PAPD one. The audit of the phase
+			 * boundaries finds no transition before the TX I/Q LO
+			 * step and none after the RX I/Q one, so the other steps
+			 * do not get one: the control is already off and an open
+			 * here is 172 operations the hardware never sees.
+			 */
+			b43_nphy_pwr_ctl_open(dev, orig_tx_gain);
+			b43_nphy_papd_cal(dev);
+			break;
+		case B43_NPHY_MPHASE_RXCAL:
+			/* The calibration transmits for a long time, so the
+			 * medium gets protected for as long: the reference sets
+			 * the duration the ucode sends CTS for at the head of
+			 * this phase and of no other, and it has to happen with
+			 * the MAC running. Nothing else in b43 writes this cell.
+			 */
+			b43_mac_enable(dev);
+			b43_shm_write16(dev, B43_SHM_SHARED,
+					B43_SHM_SH_CTSDUR, 10000);
+			b43_mac_suspend(dev);
+
+			/* The RX I/Q calibration, the power coefficients and the
+			 * RSSI calibration are one step: in the capture they run
+			 * back to back, with nothing between the end of one and
+			 * the start of the next that a bracket could hold. The
+			 * RSSICAL phase below is therefore empty.
+			 */
+			/* The gains at the forced index, the same ones the TX
+			 * I/Q LO calibration used, and not the ones the
+			 * sequence was entered with: the capture writes 0x4077
+			 * on both chains, which is the calibration gain for
+			 * index 10, the index the precalibration forces on
+			 * both. Entering with the per-chain indices would give
+			 * 0x4077 and 0x4067.
+			 */
+			if (b43_nphy_cal_rx_iq(dev, cal_target, 2, 0) == 0)
+				b43_nphy_save_cal(dev);
+			b43_nphy_tx_pwr_ctrl_coef_setup(dev);
+			b43_nphy_rssi_cal(dev);
+			b43_radio_2057_vcocal(dev);
+			break;
+		case B43_NPHY_MPHASE_RSSICAL:
+			break;
+		case B43_NPHY_MPHASE_IDLETSSI:
+			/* What the reference does on the first calibration
+			 * after an association, which an interface coming up
+			 * is.
+			 */
+			b43_nphy_tx_power_ctl_idle_tssi(dev);
+			b43_nphy_tx_power_ctl_setup(dev);
+			break;
+		}
+
+	}
+
+	/* Both chains go back on the index their power control was on when the
+	 * sequence started, one core at a time. The reference does this in the
+	 * tail of every invocation, gated on the control having been on.
+	 */
+	if (entry_pwr_ctrl_state) {
+		b43_nphy_txpwr_index(dev, 1 << 0, nphy->pwr_idx_at_gain[0],
+				     false);
+		b43_nphy_txpwr_index(dev, 1 << 1, nphy->pwr_idx_at_gain[1],
+				     false);
+	}
+
+	/* The control stays off for the whole sequence and comes back once, on
+	 * the state the sequence was entered with: the capture has no transition
+	 * that turns it on between two phases, only the ones that turn it off.
+	 */
+	b43_nphy_pwr_ctl_close(dev, entry_pwr_ctrl_state);
+	nphy->mphase_cal_phase_id = 0;
+}
+
+/* The deferred calibration sequence. It runs after b43_nphy_op_recalc_txpower()
+ * rather than at the end of b43_phy_initn(), because that is the order the
+ * capture has: init, then the power recalculation, then the calibration. In the
+ * reference the watchdog is what starts it, and b43 has no equivalent.
+ */
+static void b43_nphy_run_pending_perical(struct b43_wldev *dev)
+{
+	struct b43_phy_n *nphy = dev->phy.n;
+	struct nphy_txgains target;
+	struct nphy_txgains cal_target;
+	bool entry_pwr_ctrl_state;
+
+	if (!nphy->perical_pending)
