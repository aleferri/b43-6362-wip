+static int b43_nphy_rev3_cal_rx_iq(struct b43_wldev *dev,
+			struct nphy_txgains target, u8 type, bool debug)
+{
+	struct b43_phy *phy = &dev->phy;
+	struct nphy_iqcal_params cal_params[2];
+	u16 gain_save[2], cal_gain[2];
+	u16 orig_bbcfg;
+	u8 rx_core_state;
+	u8 core;
+
+	/* Only radio 2057 rev 8 in 2 GHz has been looked at against a capture,
+	 * and the gain sweep only has the 2 GHz ladder.
+	 */
+	if (phy->rev != 8 || phy->radio_rev != 8 ||
+	    b43_current_band(dev->wl) != NL80211_BAND_2GHZ)
+		return -1;
+
+	orig_bbcfg = b43_phy_read(dev, B43_NPHY_BBCFG);
+	b43_phy_mask(dev, B43_NPHY_BBCFG, ~B43_NPHY_BBCFG_RSTRX & 0xFFFF);
+
+	b43_nphy_stay_in_carrier_search(dev, true);
+
+	/* The transmit gain of the two cores together, put back at the end, and
+	 * the gain the calibration wants in its place.
+	 */
+	b43_ntab_read_bulk(dev, B43_NTAB16(7, 0x110), 2, gain_save);
+	for (core = 0; core < 2; core++) {
+		b43_nphy_iq_cal_gain_params(dev, core, target,
+					    &cal_params[core]);
+		cal_gain[core] = cal_params[core].cal_gain;
+	}
+	b43_ntab_write_bulk(dev, B43_NTAB16(7, 0x110), 2, cal_gain);
+
+	rx_core_state = b43_nphy_get_rx_core_state(dev);
+
+	/* One core at a time: hand the PHY and the radio over, sweep the receive
+	 * gain until the tone comes back at a workable power, measure it and
+	 * compute the compensation, then take the PHY back.
+	 */
+	for (core = 0; core < 2; core++) {
+		b43_nphy_rxcal_phy_setup(dev, core);
+		b43_nphy_rxcal_radio_setup(dev, core);
+
+		if (rx_core_state & (1 << core)) {
+			b43_nphy_rxcal_gainctrl(dev, core, 0);
+
+			b43_nphy_tx_tone(dev, b43_is_40mhz(dev) ?
+					 B43_NPHY_RXCAL_TONEFREQ_40MHZ :
+					 B43_NPHY_RXCAL_TONEFREQ_20MHZ,
+					 B43_NPHY_RXCAL_TONEAMP, false, type,
+					 false);
+			b43_nphy_calc_rx_iq_comp(dev, 1 << core);
+			b43_nphy_stop_playback(dev);
+		}
+
+		b43_nphy_rxcal_radio_cleanup(dev, core);
+		b43_nphy_rxcal_phy_cleanup(dev, core);
+		b43_nphy_force_rf_sequence(dev, B43_RFSEQ_RESET2RX);
+	}
+
+	b43_phy_write(dev, B43_NPHY_BBCFG, orig_bbcfg);
+
+	b43_nphy_reset_cca(dev);
+	b43_nphy_rf_ctl_override_one_to_many(dev, N_RF_CTL_OVER_CMD_RX_GAIN, 0,
+					     0x3, true);
+	b43_nphy_force_rf_sequence(dev, B43_RFSEQ_RESET2RX);
+
+	b43_ntab_write_bulk(dev, B43_NTAB16(7, 0x110), 2, gain_save);
+
+	b43_nphy_stay_in_carrier_search(dev, false);
+
+	return 0;
+}
+
+/* https://bcm-v4.sipsolutions.net/802.11/PHY/N/CalRxIq */
+static int b43_nphy_cal_rx_iq(struct b43_wldev *dev,
+			struct nphy_txgains target, u8 type, bool debug)
+{
+	if (dev->phy.rev >= 3)
+		return b43_nphy_rev3_cal_rx_iq(dev, target, type, debug);
+	else
+		return b43_nphy_rev2_cal_rx_iq(dev, target, type, debug);
+}
