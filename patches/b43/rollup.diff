+
+/* The two epsilon tables, cleared one cell at a time, one core after the other,
+ * the way brcmsmac and the hardware's own driver do it.
+ */
+static void b43_nphy_papd_epsilon_tables_clear(struct b43_wldev *dev)
+{
+	int i;
+
+	for (i = 0; i < 64; i++)
+		b43_ntab_write(dev, B43_NTAB32(31, i), 0);
+	for (i = 0; i < 64; i++)
+		b43_ntab_write(dev, B43_NTAB32(33, i), 0);
+}
