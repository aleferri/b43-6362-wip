+
+	b43_ntab_write(dev, B43_NTAB16(15, 87), m0m1);
+	b43_ntab_write(dev, B43_NTAB16(15, 95), m0m1);
+}
+
+/* Put one transmit chain on a chosen index of the power control table, the way
+ * brcmsmac's wlc_phy_txpwr_index_nphy() does for a non-negative index. The
+ * three tables the index selects sit 128 cells apart: the gain at 192, the IQ
+ * compensation at 320, the local oscillator compensation at 448, and on an
+ * internal PA the RF power offset at 576.
+ *
+ * A negative index means the other direction: hand the chain back the gain, the
+ * multiplier and the compensations it had before an index was first forced on
+ * it.
+ */
+static void b43_nphy_txpwr_index(struct b43_wldev *dev, u8 core_mask,
+				 s8 txpwrindex, bool restore_cals)
+{
+	struct b43_phy_n *nphy = dev->phy.n;
+	struct b43_phy_n_txpwrindex *saved;
+	bool tx_pwr_ctrl_state;
+	u16 rad_gain, dac_gain, m1m2, tmp;
+	u16 iqcomp_a, iqcomp_b, regval[2];
+	u32 txgain, iqcomp, locomp;
+	s32 rfpwr_offset;
+	u8 bbmult, core, tbl;
+
+	if (nphy->hang_avoid)
+		b43_nphy_stay_in_carrier_search(dev, true);
+
+	for (core = 0; core < 2; core++) {
+		if (!(core_mask & (1 << core)))
+			continue;
+
+		tbl = core ? 27 : 26;
+		saved = &nphy->txpwrindex[core];
+
+		/* Hand the chain back what it had before an index was forced on
+		 * it. Nothing to hand back if nothing was forced.
+		 */
+		if (txpwrindex < 0) {
+			if (saved->index < 0)
+				continue;
+
+			b43_phy_maskset(dev, B43_NPHY_AFECTL_OVER1, ~0x0100,
+					saved->AfectrlOverride & 0x0100);
+			b43_phy_maskset(dev, B43_NPHY_AFECTL_OVER, ~0x0100,
+					saved->AfectrlOverride & 0x0100);
+			b43_phy_write(dev, core ? B43_NPHY_AFECTL_DACGAIN2 :
+						  B43_NPHY_AFECTL_DACGAIN1,
+				      saved->AfeCtrlDacGain);
+
+			b43_ntab_write(dev, B43_NTAB16(7, 0x110 + core),
+				       saved->rad_gain);
+
+			m1m2 = b43_ntab_read(dev, B43_NTAB16(15, 87));
+			if (core == 0)
+				m1m2 = (m1m2 & 0x00FF) | (saved->bbmult << 8);
+			else
+				m1m2 = (m1m2 & 0xFF00) | saved->bbmult;
+			b43_ntab_write(dev, B43_NTAB16(15, 87), m1m2);
+
+			if (restore_cals) {
+				regval[0] = saved->iqcomp_a;
+				regval[1] = saved->iqcomp_b;
+				b43_ntab_write_bulk(dev,
+						    B43_NTAB16(15, 80 + 2 * core),
+						    2, regval);
+				b43_ntab_write(dev, B43_NTAB16(15, 85 + core),
+					       saved->locomp);
+				b43_ntab_write(dev, B43_NTAB16(15, 93 + core),
+					       saved->locomp);
+			}
+
+			b43_nphy_tx_power_ctrl(dev, nphy->txpwrctrl);
+			saved->index_internal = saved->index_internal_save;
+			saved->index = -1;
+			continue;
+		}
+
+		/* First time an index is forced on this chain, remember what it
+		 * is being forced over.
+		 */
+		if (saved->index < 0) {
+			b43_phy_maskset(dev, B43_NPHY_AFECTL_OVER1, ~0x0100,
+					saved->AfectrlOverride & 0x0100);
+			b43_phy_maskset(dev, B43_NPHY_AFECTL_OVER, ~0x0100,
+					saved->AfectrlOverride & 0x0100);
+			saved->AfeCtrlDacGain =
+				b43_phy_read(dev, core ?
+					     B43_NPHY_AFECTL_DACGAIN2 :
+					     B43_NPHY_AFECTL_DACGAIN1);
+			saved->rad_gain =
+				b43_ntab_read(dev, B43_NTAB16(7, 0x110 + core));
+			tmp = b43_ntab_read(dev, B43_NTAB16(15, 87));
+			saved->bbmult = (tmp >> (core ? 0 : 8)) & 0xFF;
+			b43_ntab_read_bulk(dev, B43_NTAB16(15, 80 + 2 * core),
+					   2, regval);
+			saved->iqcomp_a = regval[0];
+			saved->iqcomp_b = regval[1];
+			saved->locomp =
+				b43_ntab_read(dev, B43_NTAB16(15, 85 + core));
+			saved->index_internal_save = saved->index_internal;
+		}
+
+		tx_pwr_ctrl_state = nphy->txpwrctrl;
+		b43_nphy_tx_power_ctrl(dev, false);
+
+		txgain = b43_ntab_read(dev, B43_NTAB32(tbl, 192 + txpwrindex));
+		rad_gain = (txgain >> 16) & 0x1FFFF;
+		dac_gain = (txgain >> 8) & 0x3F;
+		bbmult = txgain & 0xFF;
+
+		b43_phy_maskset(dev, core ? B43_NPHY_AFECTL_OVER :
+					    B43_NPHY_AFECTL_OVER1,
+				~0x0100, 0x0100);
+		b43_phy_write(dev, core ? B43_NPHY_AFECTL_DACGAIN2 :
+					  B43_NPHY_AFECTL_DACGAIN1, dac_gain);
+
+		b43_ntab_write(dev, B43_NTAB16(7, 0x110 + core), rad_gain);
+
+		/* The multiplier lives in two cells, 87 and 95, and both get the
+		 * core's half read-modify-written - not one written and the other
+		 * copied. The capture shows the second one being read before it
+		 * is written, and with the same value in it as the first had, so
+		 * the two are kept in step rather than one being derived from the
+		 * other.
+		 *
+		 * Which callers write both is measured and it is not by phase: of
+		 * the 70 writes to 87 in the capture 40 have a write to 95 beside
+		 * them and 30 do not, and inside the gain sweep alone five are
+		 * paired and seven are not. The paired ones are the calls to this
+		 * function and the PAPD calibration; the bare ones are stopping
+		 * the sample playback and b43_nphy_tx_power_fix(), which write 87
+		 * alone and are left as they are.
+		 */
+		m1m2 = b43_ntab_read(dev, B43_NTAB16(15, 87));
+		if (core == 0)
+			m1m2 = (m1m2 & 0x00FF) | (bbmult << 8);
+		else
+			m1m2 = (m1m2 & 0xFF00) | bbmult;
+		b43_ntab_write(dev, B43_NTAB16(15, 87), m1m2);
+
+		m1m2 = b43_ntab_read(dev, B43_NTAB16(15, 95));
+		if (core == 0)
+			m1m2 = (m1m2 & 0x00FF) | (bbmult << 8);
+		else
+			m1m2 = (m1m2 & 0xFF00) | bbmult;
+		b43_ntab_write(dev, B43_NTAB16(15, 95), m1m2);
+
+		iqcomp = b43_ntab_read(dev, B43_NTAB32(tbl, 320 + txpwrindex));
+		iqcomp_a = (iqcomp >> 10) & 0x3FF;
+		iqcomp_b = iqcomp & 0x3FF;
+		if (restore_cals) {
+			regval[0] = iqcomp_a;
+			regval[1] = iqcomp_b;
+			b43_ntab_write_bulk(dev, B43_NTAB16(15, 80 + 2 * core),
+					    2, regval);
+		}
+
+		locomp = b43_ntab_read(dev, B43_NTAB32(tbl, 448 + txpwrindex));
+		if (restore_cals)
+			b43_ntab_write(dev, B43_NTAB16(15, 85 + core), locomp);
+
+		if (b43_nphy_ipa(dev)) {
+			rfpwr_offset = b43_ntab_read(dev,
+					B43_NTAB32(tbl, 576 + txpwrindex));
+			b43_phy_maskset(dev, core ? B43_NPHY_PAPD_EN1 :
+						    B43_NPHY_PAPD_EN0,
+					~0x1FF0 & 0xFFFF,
+					(((s16)rfpwr_offset) << 4) & 0x1FF0);
+			b43_phy_set(dev, core ? B43_NPHY_PAPD_EN1 :
+					        B43_NPHY_PAPD_EN0, 0x4);
+		}
+
+		b43_nphy_tx_power_ctrl(dev, tx_pwr_ctrl_state);
+
+		saved->index = txpwrindex;
+	}
+
+	if (nphy->hang_avoid)
+		b43_nphy_stay_in_carrier_search(dev, false);
+}
