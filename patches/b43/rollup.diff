+		b43_ntab_write(dev, B43_NTAB16(7, 0x110 + core), rad_gain);
+
+		/* The multiplier lives in two cells, 87 and 95, and both get the
+		 * core's half read-modify-written - not one written and the other
+		 * copied. The capture shows the second one being read before it
+		 * is written, and with the same value in it as the first had, so
+		 * the two are kept in step rather than one being derived from the
+		 * other.
+		 *
+		 * Which callers write both is measured and it is not by phase: of
+		 * the 70 writes to 87 in the capture 40 have a write to 95 beside
+		 * them and 30 do not, and inside the gain sweep alone five are
+		 * paired and seven are not. The paired ones are the calls to this
+		 * function and the PAPD calibration; the bare ones are stopping
+		 * the sample playback and b43_nphy_tx_power_fix(), which write 87
+		 * alone and are left as they are.
+		 */
+		m1m2 = b43_ntab_read(dev, B43_NTAB16(15, 87));
+		if (core == 0)
+			m1m2 = (m1m2 & 0x00FF) | (bbmult << 8);
+		else
+			m1m2 = (m1m2 & 0xFF00) | bbmult;
+		b43_ntab_write(dev, B43_NTAB16(15, 87), m1m2);
+
+		m1m2 = b43_ntab_read(dev, B43_NTAB16(15, 95));
+		if (core == 0)
+			m1m2 = (m1m2 & 0x00FF) | (bbmult << 8);
+		else
+			m1m2 = (m1m2 & 0xFF00) | bbmult;
+		b43_ntab_write(dev, B43_NTAB16(15, 95), m1m2);
+
+		iqcomp = b43_ntab_read(dev, B43_NTAB32(tbl, 320 + txpwrindex));
+		iqcomp_a = (iqcomp >> 10) & 0x3FF;
+		iqcomp_b = iqcomp & 0x3FF;
+		if (restore_cals) {
+			regval[0] = iqcomp_a;
+			regval[1] = iqcomp_b;
+			b43_ntab_write_bulk(dev, B43_NTAB16(15, 80 + 2 * core),
+					    2, regval);
+		}
+
+		locomp = b43_ntab_read(dev, B43_NTAB32(tbl, 448 + txpwrindex));
+		if (restore_cals)
+			b43_ntab_write(dev, B43_NTAB16(15, 85 + core), locomp);
+
+		if (b43_nphy_ipa(dev)) {
+			rfpwr_offset = b43_ntab_read(dev,
+					B43_NTAB32(tbl, 576 + txpwrindex));
+			b43_phy_maskset(dev, core ? B43_NPHY_PAPD_EN1 :
+						    B43_NPHY_PAPD_EN0,
+					~0x1FF0 & 0xFFFF,
+					(((s16)rfpwr_offset) << 4) & 0x1FF0);
+			b43_phy_set(dev, core ? B43_NPHY_PAPD_EN1 :
+					        B43_NPHY_PAPD_EN0, 0x4);
+		}
+
+		b43_nphy_tx_power_ctrl(dev, tx_pwr_ctrl_state);
+
+		saved->index = txpwrindex;
+	}
+
+	if (nphy->hang_avoid)
+		b43_nphy_stay_in_carrier_search(dev, false);
+}
