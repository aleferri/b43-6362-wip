+/* Put one transmit chain on a chosen index of the power control table, the way
+ * brcmsmac's wlc_phy_txpwr_index_nphy() does for a non-negative index. The
+ * three tables the index selects sit 128 cells apart: the gain at 192, the IQ
+ * compensation at 320, the local oscillator compensation at 448, and on an
+ * internal PA the RF power offset at 576.
+ *
+ * A negative index means the other direction: hand the chain back the gain, the
+ * multiplier and the compensations it had before an index was first forced on
+ * it.
+ */
+static void b43_nphy_txpwr_index(struct b43_wldev *dev, u8 core_mask,
+				 s8 txpwrindex, bool restore_cals)
+{
+	struct b43_phy_n *nphy = dev->phy.n;
+	struct b43_phy_n_txpwrindex *saved;
+	bool tx_pwr_ctrl_state;
+	u16 rad_gain, dac_gain, m1m2, tmp;
+	u16 iqcomp_a, iqcomp_b, regval[2];
+	u32 txgain, iqcomp, locomp;
+	s32 rfpwr_offset;
+	u8 bbmult, core, tbl;
+
+	if (nphy->hang_avoid)
+		b43_nphy_stay_in_carrier_search(dev, true);
+
+	for (core = 0; core < 2; core++) {
+		if (!(core_mask & (1 << core)))
+			continue;
+
+		tbl = core ? 27 : 26;
+		saved = &nphy->txpwrindex[core];
+
+		/* Hand the chain back what it had before an index was forced on
+		 * it. Nothing to hand back if nothing was forced.
+		 */
+		if (txpwrindex < 0) {
+			if (saved->index < 0)
+				continue;
+
+			b43_phy_maskset(dev, B43_NPHY_AFECTL_OVER1, ~0x0100,
+					saved->AfectrlOverride & 0x0100);
+			b43_phy_maskset(dev, B43_NPHY_AFECTL_OVER, ~0x0100,
+					saved->AfectrlOverride & 0x0100);
+			b43_phy_write(dev, core ? B43_NPHY_AFECTL_DACGAIN2 :
+						  B43_NPHY_AFECTL_DACGAIN1,
+				      saved->AfeCtrlDacGain);
+
+			b43_ntab_write(dev, B43_NTAB16(7, 0x110 + core),
+				       saved->rad_gain);
+
+			/* Both cells, like the forcing path below: the capture
+			 * read-modify-writes 87 and then 95 here too. The
+			 * reference only touches 87.
+			 */
